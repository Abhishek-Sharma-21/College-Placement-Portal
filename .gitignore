# ============================
# ROOT-LEVEL SECURITY GITIGNORE
# ============================

# NEVER commit any .env files from any subfolder
**/.env
**/.env.*

# Private keys, SSL certs, credentials
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/*.p12
**/*.pfx
**/secrets/
**/credentials.json
**/service-account*.json

# Node dependencies everywhere
**/node_modules/

# Builds & Outputs
dist/
build/
.vite/
uploads/

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*

# OS Metadata & IDEs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
